# Copy this file to .env and change values as needed.
# Paths may be absolute or relative to the project root.
SONG_LIBRARY_PATH=library
SONG_COVER_CACHE_PATH=public/cache/covers

# Public site origin used for canonical, social-image, and audio metadata.
SONG_SITE_ORIGIN=https://example.com

# true: show and permit ZIP downloads
# false: hide and reject ZIP downloads (playback remains available)
SONG_DOWNLOADS_ENABLED=true
